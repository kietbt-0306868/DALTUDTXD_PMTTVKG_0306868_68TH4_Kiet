        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views"
        Title="Thiết kế ván khuôn — Add-in Revit"
        MinHeight="650" MinWidth="1050"
        Background="White" FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="307*"/>
        </Grid.ColumnDefinitions>
        <views:DuLieuView x:Name="DuLieuTab" Visibility="Visible" Grid.ColumnSpan="2" />
        <views:TinhToanView x:Name="TinhToanTab" Visibility="Collapsed" Grid.ColumnSpan="2" />
        <views:ThongSoView x:Name="ThongSoTab" Visibility="Collapsed" Grid.ColumnSpan="2" />
        <views:KetQuaView x:Name="KetQuaTab" Visibility="Collapsed" Grid.ColumnSpan="2" />
        <views:Preview3DView x:Name="Preview3DTab" Visibility="Collapsed" Grid.ColumnSpan="2" />
    </Grid>
</Window>