<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <!-- Compile for .NET 8 (Revit 2025) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Revit 2025 and its managed API assemblies are 64-bit. Keep the DLL
         x64 even when Visual Studio opens the solution in its Any CPU config. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Shorten intermediate/output paths: set in Directory.Build.props before Microsoft.Common.props import -->
  </PropertyGroup>

  <!-- Configure RevitVersion variable -->
  <PropertyGroup>
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>

  <!-- Revit 2025 APIs (via NuGet, no installation required) -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.2" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- General Packages -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="HelixToolkit" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="MiniWord" Version="0.9.2" />
  </ItemGroup>

  <!-- Deploy automatically for the developer when building -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if not exist &quot;$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\DALTUDTXD_68TH4_PMTKVK_REVITAPI&quot; mkdir &quot;$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\DALTUDTXD_68TH4_PMTKVK_REVITAPI&quot;&#xD;&#xA;copy &quot;$(TargetDir)*.*&quot; &quot;$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\DALTUDTXD_68TH4_PMTKVK_REVITAPI\&quot;&#xD;&#xA;copy &quot;$(ProjectDir)DALTUDTXD_68TH4_PMTKVK_REVITAPI.addin&quot; &quot;$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\&quot;" />
  </Target>
</Project>
