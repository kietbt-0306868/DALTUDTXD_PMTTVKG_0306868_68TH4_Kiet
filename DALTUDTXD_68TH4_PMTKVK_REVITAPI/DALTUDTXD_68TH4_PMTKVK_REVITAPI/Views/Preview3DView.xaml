<UserControl x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
    Background="#F5F5F5">
    <Grid>
        <!-- Native Revit View3D: the live project model plus add-in-owned DirectShapes. -->
        <ContentControl Content="{Binding NativePreviewControl}" Panel.ZIndex="0"/>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="#EFFFFFFF"
                Padding="12"
                Margin="12"
                CornerRadius="5"
                Panel.ZIndex="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="MÔ HÌNH VÁN KHUÔN TOÀN DỰ ÁN"
                           FontWeight="Bold"
                           Foreground="#2C3E50" />
                <TextBlock Text="{Binding RenderSummary}"
                           FontSize="11"
                           Foreground="#566573"
                           Margin="0,5,0,0" />
                <TextBlock Text="Bê tông theo hình học Revit; ván khuôn được đặt đúng vị trí và cao độ."
                           FontSize="10"
                           Foreground="#7F8C8D"
                           Margin="0,3,0,0" />
                <TextBlock Text="{Binding GroundFloorShoringRuleText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#0F766E"
                           TextWrapping="Wrap"
                           MaxWidth="610"
                           Margin="0,4,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" Fill="#2563EB" Margin="0,2,4,0"/>
                    <TextBlock Text="Cây chống" FontSize="10" Margin="0,0,12,0"/>
                    <Ellipse Width="10" Height="10" Fill="#F97316" Margin="0,2,4,0"/>
                    <TextBlock Text="Gông/kẹp" FontSize="10" Margin="0,0,12,0"/>
                    <Ellipse Width="10" Height="10" Fill="#9333EA" Margin="0,2,4,0"/>
                    <TextBlock Text="Ty ren" FontSize="10" Margin="0,0,12,0"/>
                    <Ellipse Width="10" Height="10" Fill="#16A34A" Margin="0,2,4,0"/>
                    <TextBlock Text="Giằng/chống xiên" FontSize="10"/>
                </WrapPanel>
                <TextBlock Text="{Binding AccessoryInteractionText}"
                           FontSize="10" Foreground="#475569" Margin="0,7,0,0"
                           TextWrapping="Wrap" MaxWidth="610"/>
                <Button Content="DỰNG PHỤ KIỆN FAMILY CÓ THỂ CHỈNH SỬA"
                        Command="{Binding RenderEditableFamiliesCommand}"
                        HorizontalAlignment="Left" Margin="0,7,0,0" Padding="10,5"
                        Background="#6D28D9" Foreground="White" BorderThickness="0"
                        FontSize="10" FontWeight="SemiBold"/>
                <Button Content="MỞ VIEW REVIT ĐỂ CHỌN VÀ CHỈNH SỬA FAMILY"
                        Command="{Binding OpenEditableRevitViewCommand}"
                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="10,5"
                        Background="#0F766E" Foreground="White" BorderThickness="0"
                        FontSize="10" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="22"
                CornerRadius="8"
                Background="#EEFFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Panel.ZIndex="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRendering}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="ĐANG DỰNG MÔ HÌNH 3D REVIT"
                           FontSize="17" FontWeight="Bold" Foreground="#1E3A5F"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding RenderProgressText}"
                           Margin="0,12,0,8" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Foreground="#475569"/>
                <ProgressBar Height="18" Minimum="0" Maximum="100"
                             Value="{Binding RenderProgress, Mode=OneWay}"/>
                <Grid Margin="0,7,0,0">
                    <TextBlock Text="{Binding RenderRemainingText}" Foreground="#64748B"/>
                    <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0F766E">
                        <Run Text="{Binding RenderProgress, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>
                <Button Content="HỦY DỰNG 3D"
                        Command="{Binding CancelRenderCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0" Padding="22,7"
                        Background="#FFFFFF" Foreground="#B91C1C"
                        BorderBrush="#FCA5A5" BorderThickness="1"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!--
            Do not instantiate HelixToolkit/SharpDX in the Revit-hosted window. Revit owns
            the DirectX device and the second SharpDX viewport could crash the process as
            soon as this tab became visible. The project preview is exclusively Revit's
            native PreviewControl; the calculation workflow remains available without 3D.
        -->
        <Border Background="#F8FAFC" Panel.ZIndex="-1"/>
    </Grid>
</UserControl>
