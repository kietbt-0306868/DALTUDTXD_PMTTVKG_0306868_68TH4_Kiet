<UserControl x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.Preview3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hx="http://helix-toolkit.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F5F5">
    <Grid>
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="#EFFFFFFF"
                Padding="12"
                Margin="12"
                CornerRadius="5"
                Panel.ZIndex="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="MÔ HÌNH VÁN KHUÔN TOÀN DỰ ÁN"
                           FontWeight="Bold"
                           Foreground="#2C3E50" />
                <TextBlock Text="{Binding RenderSummary}"
                           FontSize="11"
                           Foreground="#566573"
                           Margin="0,5,0,0" />
                <TextBlock Text="Bê tông theo hình học Revit; ván khuôn được đặt đúng vị trí và cao độ."
                           FontSize="10"
                           Foreground="#7F8C8D"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="Đang dựng toàn bộ mô hình kết cấu và ván khuôn..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="Gray"
                   Panel.ZIndex="1">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRendering}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <hx:HelixViewport3D x:Name="Viewport"
                            ZoomExtentsWhenLoaded="True"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            ModelUpDirection="0,0,1"
                            CameraMode="Inspect"
                            Background="Transparent"
                            IsRotationEnabled="True"
                            IsPanEnabled="True"
                            IsZoomEnabled="True"
                            EnableDecimation="True"
                            DecimationFactor="0.5"
                            FXAASamples="4"
                            RenderOptions.EdgeMode="Aliased"
                            TexturingQuality="Low">
            <hx:DefaultLights />
            <ModelVisual3D Content="{Binding ModelGroup}" />
        </hx:HelixViewport3D>
    </Grid>
</UserControl>
