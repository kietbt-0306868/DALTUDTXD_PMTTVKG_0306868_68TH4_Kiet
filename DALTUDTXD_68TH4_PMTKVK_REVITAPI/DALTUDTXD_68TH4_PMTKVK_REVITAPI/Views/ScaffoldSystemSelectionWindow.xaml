<Window x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.ScaffoldSystemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn hệ giàn giáo" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="HỆ GIÀN GIÁO DÙNG CHO SÀN VÀ DẦM"
                       FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
            <TextBlock Margin="0,6,0,12" Foreground="#475569" TextWrapping="Wrap"
                       Text="Chọn ít nhất một loại. Nếu chọn nhiều loại, phần mềm chia chúng theo vùng liên tục và không xen kẽ hai hệ trong cùng một vùng giàn giáo."/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1"
                BorderThickness="1" CornerRadius="5" Padding="14">
            <StackPanel>
                <CheckBox x:Name="FrameCheckBox" Margin="0,3" Padding="2"
                          Content="Giàn giáo khung (khung H/truyền thống)"/>
                <TextBlock Margin="24,1,0,7" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Phù hợp các ô lưới đều, chiều cao tầng thông dụng và thi công theo dãy khung."/>
                <CheckBox x:Name="WedgeCheckBox" Margin="0,3" Padding="2"
                          Content="Giàn giáo nêm"/>
                <TextBlock Margin="24,1,0,7" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Lắp ghép nhanh theo mô-đun; dùng thành một vùng riêng khi được chọn cùng hệ khác."/>
                <CheckBox x:Name="RinglockCheckBox" Margin="0,3" Padding="2"
                          Content="Giàn giáo Ringlock"/>
                <TextBlock Margin="24,1,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Mặc định; phù hợp lưới chống mô-đun và liên kết nhiều phương."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" MinWidth="86" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Áp dụng" IsDefault="True" MinWidth="100" Padding="12,6"
                    Background="#0F766E" Foreground="White" BorderBrush="#0F766E"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
