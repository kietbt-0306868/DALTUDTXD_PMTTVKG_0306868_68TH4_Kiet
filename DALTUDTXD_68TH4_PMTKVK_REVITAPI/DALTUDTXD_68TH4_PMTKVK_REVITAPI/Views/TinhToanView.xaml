<UserControl x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.TinhToanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views"
             xmlns:vm="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:TinhToanViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CalcTextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="CalcTextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="CalcAccent" Color="#0F766E"/>
        <SolidColorBrush x:Key="CalcFormula" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="CalcBorder" Color="#CBD5E1"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CalcTextPrimary}"/>
        </Style>
        <Style x:Key="CalcSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CalcTextPrimary}"/>
        </Style>
        <Style x:Key="CalcLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CalcTextSecondary}"/>
        </Style>
        <Style x:Key="CalcValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CalcTextPrimary}"/>
        </Style>
        <Style x:Key="CalcFormulaStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource CalcFormula}"/>
        </Style>
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Menu Hệ Thống -->
            <Menu Grid.Row="0" Background="#F3F3F3" Foreground="Black">
                <MenuItem Header=""/>
            </Menu>
            
            <!-- Toolbar Tính Toán -->
            <Grid Grid.Row="1" Background="#F8F9F9">
                <Grid Margin="5,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Chạy tính toán lại" Command="{Binding RecalculateCommand}"
                            Style="{StaticResource CalcButtonStyle}" Background="White" BorderBrush="#CBD5E1" Foreground="#1E293B" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Tự động thiết kế đạt chuẩn" Command="{Binding AutoFixPropsCommand}"
                            Style="{StaticResource CalcButtonStyle}" Background="#0F766E" BorderBrush="#0F766E" Foreground="White" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding AutoDesignStatus}" Foreground="{Binding AutoDesignStatusColor}"
                               FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Grid>

            <!-- Vùng Hiển Thị Chính -->
            <Grid Grid.Row="2" Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột Tính Toán -->
                <Grid Grid.Column="0" Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Banner trạng thái tổng thể -->
                    <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="3" Padding="12" 
                            Background="{Binding IsSystemSafeColor, TargetNullValue='#D1FAE5'}" 
                            BorderBrush="{Binding IsSystemSafeBorderColor, TargetNullValue='#10B981'}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform" Fill="{Binding IsSystemSafeIconColor, TargetNullValue='#10B981'}" Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2ZM10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedFloorInfo}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SystemSafeTitle, TargetNullValue='HỆ THỐNG ĐẠT YÊU CẦU AN TOÀN KỸ THUẬT'}" FontSize="12" FontWeight="Bold" Foreground="{Binding IsSystemSafeTextColor, TargetNullValue='#065F46'}"/>
                                <TextBlock Text="{Binding SystemSafeDescription, TargetNullValue='Tất cả các cấu kiện (ván mặt, xà gồ phụ, xà gồ chính, cây chống) đều thoả mãn điều kiện cường độ và độ võng.'}" FontSize="11" Foreground="{Binding IsSystemSafeTextColor, TargetNullValue='#065F46'}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Visibility="{Binding ColumnVerificationVisibility}" Margin="0,0,0,10" CornerRadius="3"
                            Padding="10" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CƠ SỞ KIỂM CHỨNG TÍNH TOÁN CỘT" FontWeight="Bold" FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ColumnPressureVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#1E40AF" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ColumnSpanVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#1E40AF" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ColumnConstructionVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#1E40AF"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Visibility="{Binding BeamVerificationVisibility}" Margin="0,0,0,10" CornerRadius="3"
                            Padding="10" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CƠ SỞ KIỂM CHỨNG CỐP PHA DẦM" FontWeight="Bold" FontSize="12" Foreground="#14532D" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BeamLoadVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#166534" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding BeamLoadPathVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#166534" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding BeamConstructionVerification}" TextWrapping="Wrap" FontSize="10.5" Foreground="#166534"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Visibility="{Binding AutoDesignDiffVisibility}" Margin="0,0,0,10"
                            CornerRadius="3" Padding="10" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="THAY ĐỔI THIẾT KẾ THEO CẤU KIỆN" FontWeight="Bold" FontSize="12"
                                       Foreground="#0F172A" Margin="0,0,0,5"/>
                            <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AutoDesignDiffItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#334155" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Chi tiết kiểm tra từng cấu kiện -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CARD 1: VÁN MẶT -->
                            <Border Grid.Row="0" Visibility="Collapsed" Background="White" Margin="0,0,0,10" CornerRadius="3" Padding="15" BorderBrush="#ABB2B9" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Card1Title}" Style="{StaticResource CalcSectionTitleStyle}"/>
                                        <Border Background="{Binding PlywoodStatusColor, TargetNullValue='#D1FAE5'}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PlywoodStatusText, TargetNullValue='ĐẠT'}" Foreground="{Binding PlywoodStatusTextColor, TargetNullValue='#065F46'}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    
                                    <Separator Background="#EEE" Margin="0,5,0,10"/>
                                    
                                    <!-- Kiểm tra ứng suất uốn -->
                                    <TextBlock Text="Ứng suất uốn (σ)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding PlywoodStressActual, TargetNullValue='8.45'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding PlywoodStressTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" MPa / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding PlywoodStressLimit, TargetNullValue='15.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" MPa" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="σ ≤ [Ru]" FontSize="10" FontStyle="Italic" Foreground="{Binding PlywoodStressTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding PlywoodStressRatio, TargetNullValue='56.3'}" Height="5" Background="#E2E8F0" Foreground="{Binding PlywoodStressColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>

                                    <!-- Kiểm tra độ võng -->
                                    <TextBlock Text="Độ võng thực tế (f_tt)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding PlywoodDeflectionActual, TargetNullValue='1.12'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding PlywoodDeflectionTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" mm / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding PlywoodDeflectionLimit, TargetNullValue='2.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" mm" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="f_tt ≤ [f]" FontSize="10" FontStyle="Italic" Foreground="{Binding PlywoodDeflectionTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding PlywoodDeflectionRatio, TargetNullValue='56.0'}" Height="5" Background="#E2E8F0" Foreground="{Binding PlywoodDeflectionColor, TargetNullValue='#10B981'}"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: XÀ GỒ PHỤ (LỚP 1) -->
                            <Border Grid.Row="1" Visibility="Collapsed" Background="White" Margin="0,0,0,10" CornerRadius="3" Padding="15" BorderBrush="#ABB2B9" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Card2Title}" Style="{StaticResource CalcSectionTitleStyle}"/>
                                        <Border Background="{Binding Joist1StatusColor, TargetNullValue='#D1FAE5'}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Joist1StatusText, TargetNullValue='ĐẠT'}" Foreground="{Binding Joist1StatusTextColor, TargetNullValue='#065F46'}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    
                                    <Separator Background="#EEE" Margin="0,5,0,10"/>
                                    
                                    <!-- Ứng suất uốn -->
                                    <TextBlock Text="Ứng suất uốn (σ)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist1StressActual, TargetNullValue='10.12'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist1StressTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" MPa / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist1StressLimit, TargetNullValue='13.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" MPa" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="σ ≤ [Ru]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist1StressTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist1StressRatio, TargetNullValue='77.8'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist1StressColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>

                                    <!-- Ứng suất cắt -->
                                    <TextBlock Text="Ứng suất cắt (τ)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist1ShearActual, TargetNullValue='1.20'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist1ShearTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" MPa / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist1ShearLimit, TargetNullValue='2.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" MPa" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="τ ≤ [τ]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist1ShearTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist1ShearRatio, TargetNullValue='60.0'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist1ShearColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>

                                    <!-- Độ võng -->
                                    <TextBlock Text="Độ võng thực tế (f_tt)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist1DeflectionActual, TargetNullValue='2.14'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist1DeflectionTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" mm / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist1DeflectionLimit, TargetNullValue='3.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" mm" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="f_tt ≤ [f]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist1DeflectionTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist1DeflectionRatio, TargetNullValue='71.3'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist1DeflectionColor, TargetNullValue='#10B981'}"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: XÀ GỒ CHÍNH (LỚP 2) -->
                            <Border Grid.Row="2" Visibility="Collapsed" Background="White" Margin="0,0,0,10" CornerRadius="3" Padding="15" BorderBrush="#ABB2B9" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Card3Title}" Style="{StaticResource CalcSectionTitleStyle}"/>
                                        <Border Background="{Binding Joist2StatusColor, TargetNullValue='#FEE2E2'}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Joist2StatusText, TargetNullValue='KHÔNG ĐẠT'}" Foreground="{Binding Joist2StatusTextColor, TargetNullValue='#991B1B'}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    
                                    <Separator Background="#EEE" Margin="0,5,0,10"/>
                                    
                                    <!-- Ứng suất uốn -->
                                    <TextBlock Text="Ứng suất uốn (σ)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist2StressActual, TargetNullValue='11.50'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist2StressTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" MPa / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist2StressLimit, TargetNullValue='13.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" MPa" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="σ ≤ [Ru]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist2StressTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist2StressRatio, TargetNullValue='88.5'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist2StressColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>

                                    <!-- Ứng suất cắt -->
                                    <TextBlock Text="Ứng suất cắt (τ)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist2ShearActual, TargetNullValue='1.50'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist2ShearTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" MPa / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist2ShearLimit, TargetNullValue='2.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" MPa" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="τ ≤ [τ]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist2ShearTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist2ShearRatio, TargetNullValue='75.0'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist2ShearColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>

                                    <!-- Độ võng -->
                                    <TextBlock Text="Độ võng thực tế (f_tt)" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Joist2DeflectionActual, TargetNullValue='4.25'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Joist2DeflectionTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" mm / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Joist2DeflectionLimit, TargetNullValue='4.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" mm" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="f_tt ≤ [f]" FontSize="10" FontStyle="Italic" Foreground="{Binding Joist2DeflectionTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Joist2DeflectionRatio, TargetNullValue='106.2'}" Height="5" Background="#E2E8F0" Foreground="{Binding Joist2DeflectionColor, TargetNullValue='#10B981'}"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 4: HỆ CÂY CHỐNG -->
                            <Border Grid.Row="3" Visibility="Collapsed" Background="White" Margin="0,0,0,5" CornerRadius="3" Padding="15" BorderBrush="#ABB2B9" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Card4Title}" Style="{StaticResource CalcSectionTitleStyle}" VerticalAlignment="Center"/>
                                        <Border Background="{Binding SupportStatusColor, TargetNullValue='#D1FAE5'}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding SupportStatusText, TargetNullValue='ĐẠT'}" Foreground="{Binding SupportStatusTextColor, TargetNullValue='#065F46'}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="🛠 Tự động sửa" Command="{Binding AutoFixPropsCommand}" Background="#E67E22" Foreground="White" BorderThickness="0" Padding="5,2" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SupportStatusText}" Value="KHÔNG ĐẠT">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>
                                    
                                    <Separator Background="#EEE" Margin="0,5,0,10"/>
                                    
                                    <!-- Lực dọc trục tác dụng -->
                                    <TextBlock Text="{Binding Card4LoadLabel}" FontSize="11" Foreground="#7F8C8D"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding SupportLoadActual, TargetNullValue='15.40'}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding SupportLoadTextColor, TargetNullValue='#2C3E50'}"/>
                                            <TextBlock Text=" kN / " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding SupportLoadLimit, TargetNullValue='25.00'}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" kN" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="P_tt ≤ [Pcp]" FontSize="10" FontStyle="Italic" Foreground="{Binding SupportLoadTextColor, TargetNullValue='#BDC3C7'}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding SupportLoadRatio, TargetNullValue='61.6'}" Height="5" Background="#E2E8F0" Foreground="{Binding SupportLoadColor, TargetNullValue='#10B981'}" Margin="0,0,0,15"/>
                                    
                                    <!-- Sức chịu tải ổn định của cột -->
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Card4FactorLabel}" FontSize="11" Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SupportSlendernessFactor, TargetNullValue='0.78'}" FontWeight="SemiBold" FontSize="11" Foreground="#2C3E50"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Background="Transparent" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="CHI TIẾT TÍNH TOÁN VÀ KIỂM TRA" Style="{StaticResource CalcSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding DetailedCheckSummary}" Margin="0,3,0,10"
                                               Style="{StaticResource CalcLabelStyle}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding DetailedChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="{Binding GroupAccent}" BorderThickness="3,1,1,1"
                                                        CornerRadius="3" Padding="15" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap">
                                                                <Run Text="{Binding Group}"/><Run Text=" · "/><Run Text="{Binding Component}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Row="0" Grid.Column="1" Background="{Binding StatusBackground}"
                                                                CornerRadius="2" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}"
                                                                       FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Separator Grid.Row="1" Grid.ColumnSpan="2" Background="#EEEEEE" Margin="0,8,0,9"/>
                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Check}" Style="{StaticResource CalcLabelStyle}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Formula}"
                                                                   Style="{StaticResource CalcFormulaStyle}"
                                                                   TextWrapping="Wrap" Margin="0,3,12,4"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="Giới hạn 100%" FontSize="10"
                                                                       Foreground="#64748B" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                                        </Grid>
                                                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="11" Foreground="#1E293B"><Run Text="Tính toán: "/><Run Text="{Binding Demand}" FontWeight="SemiBold"/></TextBlock>
                                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#1E293B"><Run Text="Cho phép: "/><Run Text="{Binding Allowable}" FontWeight="SemiBold"/></TextBlock>
                                                            <TextBlock Grid.Column="2" Text="{Binding Utilization, StringFormat={}{0:F1}%}"
                                                                       FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="4" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                                                     Value="{Binding Utilization}" Height="6"
                                                                     Background="#E2E8F0" Foreground="#2563EB"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Cột Mô Hình 2D -->
                <Border Grid.Column="1" BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="#F8F9F9" Margin="5,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header cho bản vẽ -->
                        <Border Grid.Row="0" Background="#EAEDED" Padding="8,5" CornerRadius="3,3,0,0" BorderBrush="#D5DBDB" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="MẶT BẰNG 2D DỰ ÁN" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Phạm vi tính:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold"/>
                                    <CheckBox Content="Sàn" IsChecked="{Binding IsFilterSlabChecked}" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Đưa hệ ván khuôn sàn vào tính toán và hiển thị 2D"/>
                                    <CheckBox Content="Móng" IsChecked="{Binding IsFilterFoundationChecked}" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Đưa hệ ván khuôn móng/nền vào tính toán và hiển thị 2D"/>
                                    <CheckBox Content="Dầm" IsChecked="{Binding IsFilterBeamChecked}" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Đưa hệ ván khuôn dầm vào tính toán và hiển thị 2D"/>
                                    <CheckBox Content="Cột" IsChecked="{Binding IsFilterColumnChecked}" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="Đưa hệ ván khuôn cột vào tính toán và hiển thị 2D"/>
                                    <Button Content="Bấm chọn cấu kiện" 
                                            Command="{Binding SelectFloorCommand}" 
                                            Background="#3498DB" Foreground="White" 
                                            BorderThickness="0" Padding="10,2" FontWeight="Bold" Cursor="Hand" Margin="0,0,5,0"/>
                                    <Button Content="Quét chọn nhiều cấu kiện" 
                                            Command="{Binding SweepSelectFloorCommand}" 
                                            Background="#3498DB" Foreground="White" 
                                            BorderThickness="0" Padding="10,2" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Vùng hiển thị Revit PreviewControl -->
                        <ContentControl Grid.Row="1" Content="{Binding ProjectPreview}" Margin="5"/>

                        <!-- Danh sách các sàn đã chọn (Dạng Thẻ) -->
                        <Border Grid.Row="2" BorderBrush="#ABB2B9" BorderThickness="0,1,0,0" Background="White" Padding="10,10,10,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="DANH SÁCH SÀN ĐÃ CHỌN" Foreground="#2C3E50" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" MaxHeight="220">
                                    <ItemsControl ItemsSource="{Binding FloorElements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Background="White" CornerRadius="5">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#B0B0B0" BlurRadius="6" ShadowDepth="1" Opacity="0.3" Direction="270" />
                                                    </Border.Effect>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="#3498DB" CornerRadius="5,0,0,5" />

                                                        <Grid Grid.Column="1" Margin="10,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            
                                                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                                                <!-- Nút xem chi tiết -->
                                                                <Button DockPanel.Dock="Right" Content="Tính toán" 
                                                                        Command="{Binding DataContext.ShowFloorDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="10,0,0,0" Padding="12,3" Background="#16A085" Foreground="White" BorderBrush="Transparent" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                                                                
                                                                <!-- ID phần tử -->
                                                                <Border DockPanel.Dock="Right" Background="#F4F6F6" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding ElementId, StringFormat='ID: {0}'}" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold" />
                                                                </Border>
                                                                
                                                                <!-- Tên phần tử -->
                                                                <TextBlock Text="{Binding FamilyTypeName}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </DockPanel>

                                                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                                                    <TextBlock Text="Tầng: " Foreground="#7F8C8D" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Level}" FontWeight="SemiBold" Foreground="#34495E" FontSize="11"/>
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                                                    <TextBlock Text="Diện tích: " Foreground="#7F8C8D" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Area, StringFormat='{}{0:F2} m²'}" FontWeight="SemiBold" Foreground="#34495E" FontSize="11"/>
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                                    <TextBlock Text="Chiều dày: " Foreground="#7F8C8D" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Thickness, StringFormat='{}{0:F0} mm'}" FontWeight="SemiBold" Foreground="#34495E" FontSize="11"/>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Thanh Trạng Thái -->
            <StatusBar Grid.Row="3" Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="0,1,0,0">
                <StatusBarItem Content="Ván khuôn sàn"/>
                <Separator/>
                <StatusBarItem Content="{Binding RevitVersionStatus}"/>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
