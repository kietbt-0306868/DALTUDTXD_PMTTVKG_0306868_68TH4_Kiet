<UserControl x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.ThongSoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views"
             xmlns:vm="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ThongSoViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Menu Hệ Thống -->
            <Menu Grid.Row="0" Background="#F3F3F3" Foreground="Black">
                <MenuItem Header=""/>
            </Menu>
            
            <!-- Toolbar Settings -->
            <Grid Grid.Row="1" Background="#F8F9F9">
                <StackPanel Orientation="Horizontal">
                    <Button Content=" Lưu cấu hình"        Command="{Binding SaveSettingsCommand}"        Margin="5" Padding="12,5" Background="White" BorderBrush="White" FontWeight="Bold"/>
                    <Button Content=" Đặt lại mặc định"     Command="{Binding ResetSettingsCommand}"       Margin="5" Padding="12,5" Background="White" BorderBrush="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Vùng Hiển Thị Chính -->
            <ScrollViewer Grid.Row="2" Margin="15,10" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột Trái -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <!-- Cấu hình Tiêu chuẩn & Tải trọng -->
                        <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CẤU HÌNH TIÊU CHUẨN &amp; TẢI TRỌNG THIẾT KẾ" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Tiêu chuẩn tính toán gỗ:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{Binding SelectedTieuChuan}" VerticalContentAlignment="Center" Margin="2">
                                        <ComboBoxItem Content="TCVN 9356:2012 (Gỗ)"/>
                                        <ComboBoxItem Content="EN 1995-1-1 (Eurocode 5)"/>
                                        <ComboBoxItem Content="AWC NDS-2018"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="Tải trọng bản thân ván khuôn:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WoodFormworkWeight, TargetNullValue='0.30'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="kN/m²" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Tải trọng đổ bê tông tươi:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ConcreteWeight, TargetNullValue='25.00'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="kN/m³" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Hoạt tải người &amp; thiết bị thi công:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ConstructionLiveLoad, TargetNullValue='2.50'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="kN/m²" Margin="5,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hệ số an toàn vật liệu -->
                        <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15">
                            <StackPanel>
                                <TextBlock Text="HỆ SỐ AN TOÀN VÀ HỆ SỐ ĐIỀU CHỈNH" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Hệ số tin cậy tải trọng tĩnh (γG):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding DeadLoadSafetyFactor, TargetNullValue='1.20'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="—" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Hệ số tin cậy hoạt tải (γQ):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding LiveLoadSafetyFactor, TargetNullValue='1.30'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="—" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Hệ số điều chỉnh điều kiện ẩm (m_u):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding MoistureFactor, TargetNullValue='0.85'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="—" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Hệ số điều chỉnh nhiệt độ (m_t):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding TemperatureFactor, TargetNullValue='1.00'}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="—" Margin="5,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Cột Phải -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <!-- Thông Số Vật Liệu -->
                        <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="THÔNG SỐ VẬT LIỆU" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Cường độ gỗ uốn (f):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding WoodStrength}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="MPa" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Mô đun đàn hồi (E):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ElasticModulus}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MPa" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Độ võng [f] sàn:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SlabDeflectionLimit}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="L/n" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Độ võng [f] xà gồ:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding JoistDeflectionLimit}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="L/n" Margin="5,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Thông Số Tiết Diện -->
                        <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="THÔNG SỐ TIẾT DIỆN CẤU KIỆN" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Ván mặt (dày t):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding VanMatThickness}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Xà gồ phụ (b x h):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding XaGoPhuWidth}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBox   Grid.Row="1" Grid.Column="2" Text="{Binding XaGoPhuHeight}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Xà gồ chính (b x h):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding XaGoChinhWidth}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBox   Grid.Row="2" Grid.Column="2" Text="{Binding XaGoChinhHeight}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Cây chống (D x t):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding CayChongDiameter}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBox   Grid.Row="3" Grid.Column="2" Text="{Binding CayChongThickness}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Thông Số Bố Trí -->
                        <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15">
                            <StackPanel>
                                <TextBlock Text="THÔNG SỐ BỐ TRÍ" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Khoảng cách XG phụ:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Joist1Spacing}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Khoảng cách XG chính:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Joist2Spacing}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Khoảng cách cây chống:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SupportSpacing}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Chiều cao cây chống:" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding CayChongHeight}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Text="Số nhịp ván mặt (1-3):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding SoNhipVanMat}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="nhịp" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="5" Text="Số nhịp XG phụ (1-3):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding SoNhipXaGoPhu}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="nhịp" Margin="5,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="6" Text="Số nhịp XG chính (1-3):" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding SoNhipXaGoChinh}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="nhịp" Margin="5,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Thanh Trạng Thái -->
            <StatusBar Grid.Row="3" Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="0,1,0,0">
                <StatusBarItem Content="Ván khuôn sàn"/>
                <Separator/>
                <StatusBarItem Content="{Binding RevitVersionStatus}"/>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
