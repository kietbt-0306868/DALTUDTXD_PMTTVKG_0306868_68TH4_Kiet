                                        <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ColumnPlumbTargetTolerance}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="12" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="13" Grid.ColumnSpan="3" Text="Hai hướng hở đối diện, từ ba hướng hở trở lên hoặc điểm rơi vào lỗ mở sẽ không được tự động sinh chống; kỹ sư phải xác nhận phương án riêng." Foreground="#B45309" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="KIỂM SOÁT ĐỔ BÊ TÔNG VÀ AN TOÀN THI CÔNG" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/>
                                            <RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Cốp pha vượt mạch ngừng:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ColumnFormworkTopExtension}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="Ống đổ cách chân cột:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ColumnHoseBottomClearance}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="Chiều cao mỗi đợt đổ:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ColumnPourLiftHeight}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Text="Dừng dưới đáy dầm:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ColumnBeamStopOffset}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Text="Thời gian trước tháo cốp pha:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ColumnStripTimeHours}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="giờ" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="5" Text="Thời gian dưỡng hộ tối thiểu:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ColumnCuringDays}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="ngày" Margin="5,0" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3" Content="Bố trí mâm giàn giáo và lan can an toàn" IsChecked="{Binding ColumnUseWorkPlatform}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="7" Text="Bề rộng mâm công tác:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ColumnWorkPlatformWidth}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="8" Text="Chiều cao lan can:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ColumnGuardrailHeight}" Padding="5,0" VerticalContentAlignment="Center" Margin="2"/>
                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="mm" Margin="5,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="3" Background="#F8F9F9" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="QUY TRÌNH LẮP DỰNG THEO VIDEO" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#566573" LineHeight="20"
                                               Text="1. Bật tim trục, tạo đường offset 1.000 mm.&#10;2. Quét chống dính; ghép ván 18 mm với xà gồ đứng 40×40 hoặc 50×50.&#10;3. Dựng bốn mặt; đầu ván cao hơn mạch ngừng tối thiểu 100 mm, bảo đảm kín khít.&#10;4. Lắp xà gồ/gông đôi 40×80 hoặc 50×100; khóa bằng ty D12–D16 và bát chuồn, bố trí biến bước theo cao độ.&#10;5. Cột giữa chống bốn phía; cột biên/góc bổ sung cáp neo. Lắp mâm giàn giáo và lan can.&#10;6. Dọi hai phương; đổ bằng ống mềm, đầm tránh rỗ mặt; tháo từ trên xuống sau 36–48 giờ và tiếp tục dưỡng hộ."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Thanh Trạng Thái -->
            <StatusBar Grid.Row="3" Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="0,1,0,0">
                <StatusBarItem Content="Ván khuôn sàn"/>
                <Separator/>
                <StatusBarItem Content="{Binding RevitVersionStatus}"/>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
