<Window x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.SelectGroundLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Tầng Trệt (Ground Floor)" Height="200" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Chọn tầng trệt cho dự án. Các tầng nằm bên trên tầng này sẽ mặc định sử dụng cột chống (shoring props)." TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#34495E" />
        
        <ComboBox Grid.Row="1" x:Name="LevelComboBox" DisplayMemberPath="DisplayName" Height="30" FontSize="14" VerticalContentAlignment="Center"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Xác nhận" Width="90" Height="30" Margin="0,0,10,0" Background="#3498DB" Foreground="White" FontWeight="Bold" Click="btnOk_Click"/>
            <Button Content="Hủy" Width="90" Height="30" Background="#E5E7EB" Foreground="#34495E" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
