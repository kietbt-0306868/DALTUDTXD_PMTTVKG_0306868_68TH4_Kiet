<UserControl x:Class="DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views.DuLieuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.Views"
             xmlns:vm="clr-namespace:DALTUDTXD_68TH4_PMTKVK_REVITAPI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:SharedDataViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Menu Hệ Thống -->
            <Menu Grid.Row="0" Background="#F3F3F3" Foreground="Black" Visibility="Collapsed">
                <MenuItem Header=""/>
            </Menu>

            <Border Grid.Row="0" Margin="15,10,15,0" Padding="12" Background="#F8FAFC"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="CHẠY TOÀN BỘ 6 BƯỚC"
                                Command="{Binding RunFullTakeoffWorkflowCommand}" Padding="14,7"
                                Background="#0F766E" Foreground="White" BorderBrush="#0F766E"
                                FontWeight="Bold" Cursor="Hand"/>
                        <StackPanel>
                            <TextBlock Text="BÓC TÁCH KHỐI LƯỢNG VÁN KHUÔN" FontSize="14"
                                       FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding TakeoffWorkflowStatus}" Foreground="#475569"
                                       Margin="0,3,12,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel>
                        <Button Content="1. JOIN theo trình tự" Command="{Binding JoinByConstructionSequenceCommand}"
                                Margin="0,0,6,5" Padding="10,6" ToolTip="Join các cấu kiện đang chọn theo thứ tự Móng → Cột → Dầm → Sàn"/>
                        <Button Content="2. Đặt tên cấu kiện" Command="{Binding NameFormworkComponentsCommand}"
                                Margin="0,0,6,5" Padding="10,6" ToolTip="Tạo tên VK riêng theo tầng, loại cấu kiện và số thứ tự; không ghi đè Mark hiện có"/>
                        <Button Content="3. Load Shared Parameter" Command="{Binding LoadFormworkSharedParametersCommand}"
                                Margin="0,0,6,5" Padding="10,6" ToolTip="Nạp và liên kết các tham số VK_* cho Sàn, Dầm, Cột và Móng"/>
                        <Button Content="4. Khởi tạo tính toán VK" Command="{Binding InitializeFormworkCalculationCommand}"
                                Margin="0,0,6,5" Padding="10,6" ToolTip="Đọc tải trọng, hình học và diện tích ròng rồi chuyển sang trang tính toán"/>
                        <Button Content="5. Tạo bảng thống kê" Command="{Binding CreateFormworkSchedulesCommand}"
                                Margin="0,0,6,5" Padding="10,6" ToolTip="Tạo bốn Schedule Revit cho Sàn, Dầm, Cột và Móng"/>
                        <Button Content="6. Trích xuất diện tích" Command="{Binding ExtractFormworkAreasCommand}"
                                Margin="0,0,0,5" Padding="10,6" ToolTip="Ghi diện tích ván khuôn ròng và trạng thái thiết kế vào tham số VK_*"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Vùng Hiển Thị Chính -->
            <Grid Grid.Row="1" Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <!-- Bảng Kết Quả và Danh sách sàn -->
            <ScrollViewer Grid.Column="0" Margin="0,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Danh sách các sàn đã chọn (Dạng Thẻ) -->
                    <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15" Margin="0,0,0,10">
                        <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DANH SÁCH CẤU KIỆN ĐÃ CHỌN (NHÓM THEO TẦNG / LOẠI / TÊN)" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                            <ItemsControl ItemsSource="{Binding FloorElements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Background="#FDFEFE" Padding="10">
                                            <DockPanel>
                                                <!-- Nút bấm bên phải -->
                                                <Button DockPanel.Dock="Right" Content="Chi tiết" 
                                                        Command="{Binding DataContext.ShowFloorDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="15,5" Background="#2E86C1" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand"/>
                                                
                                                <!-- Thông tin sàn bên trái -->
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FamilyTypeName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="Tầng: " Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding Level}" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                        <TextBlock Text="Diện tích: " Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding Area, StringFormat={}{0:F1} m²}" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                        <TextBlock Text="Dày: " Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding Thickness, StringFormat={}{0:F0} mm}" Foreground="#34495E" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding UniqueId, StringFormat='ID: {0}'}" Foreground="#BDC3C7" FontSize="11"/>
                                                    <TextBlock Text="{Binding FormworkName}" Foreground="#0F766E" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding ConstructionSequence, StringFormat='Trình tự: {0}'}" Foreground="#64748B" FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Bảng Kết Quả -->
                <Border BorderBrush="#ABB2B9" BorderThickness="1" CornerRadius="3" Background="White" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="BẢNG TỔNG HỢP KIỂM TRA ĐIỀU KIỆN KỸ THUẬT" Foreground="#2C3E50" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
    
                        <DataGrid ItemsSource="{Binding CheckResults}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          Background="White" 
                          RowHeight="30"
                          BorderThickness="1" 
                          BorderBrush="#D5DBDB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nội dung kiểm tra" Binding="{Binding NoiDungKiemTra}"  Width="*"/>
                                <DataGridTextColumn Header="Thực tế"           Binding="{Binding GiaTriThucTe}"   Width="90"/>
                                <DataGridTextColumn Header="Cho phép"          Binding="{Binding GiaTriChoPhep}"   Width="90"/>
                                <DataGridTemplateColumn Header="Kết luận" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MauNenTrangThai}" CornerRadius="2" Margin="2">
                                                <TextBlock Text="{Binding KetLuan}" 
                                                   Foreground="{Binding MauChuTrangThai}"
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- 2D Floor Plan Preview -->
            <Border Grid.Column="2" Margin="0,0,0,0" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="3" Background="#F8F9F9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header cho bản vẽ -->
                    <Border Grid.Row="0" Background="#EAEDED" Padding="8,5" CornerRadius="3,3,0,0" BorderBrush="#D5DBDB" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="MẶT BẰNG 2D DỰ ÁN" FontWeight="SemiBold" Foreground="#34495E" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Vùng hiển thị Revit PreviewControl -->
                    <ContentControl Grid.Row="1" Content="{Binding DuLieuPreviewControl}" Margin="5"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Thanh Trạng Thái -->
        <StatusBar Grid.Row="2" Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="0,1,0,0">
            <StatusBarItem Content="Ván khuôn sàn"/>
            <Separator/>
            <StatusBarItem Content="{Binding RevitVersionStatus}"/>
        </StatusBar>
        </Grid>
    </Grid>
</UserControl>

